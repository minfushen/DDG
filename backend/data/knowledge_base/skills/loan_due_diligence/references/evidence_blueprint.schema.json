{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoanDueDiligenceEvidenceBlueprint",
  "type": "object",
  "required": ["version", "report_outline", "chapters", "completeness_matrix"],
  "properties": {
    "version": {"type": "string"},
    "report_outline": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "required_data", "preferred_sources", "preferred_tools", "success_criteria", "fallback_language", "credit_action_when_missing"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "category": {"type": "string", "enum": ["business", "financial", "industry", "legal", "credit", "evidence", "overview", "completeness", "risk"]},
          "required_data": {"type": "array", "items": {"type": "string"}},
          "optional_data": {"type": "array", "items": {"type": "string"}},
          "preferred_sources": {"type": "array", "items": {"type": "string"}},
          "preferred_tools": {"type": "array", "items": {"type": "string"}},
          "success_criteria": {"type": "array", "items": {"type": "string"}},
          "fallback_language": {"type": "string"},
          "credit_action_when_missing": {"type": "string"},
          "display_order": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "completeness_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "chapter_id", "required_data", "high", "medium", "low", "fallback_language"],
        "properties": {
          "dimension": {"type": "string"},
          "chapter_id": {"type": "string"},
          "required_data": {"type": "array", "items": {"type": "string"}},
          "high": {"type": "string"},
          "medium": {"type": "string"},
          "low": {"type": "string"},
          "fallback_language": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
