# backend/.env.example
# 应用配置
APP_NAME=DDG-Agent-Backend
APP_VERSION=2.0.0
DEBUG=true

# 服务配置
HOST=0.0.0.0
PORT=8000

# LLM 配置 - 阿里云百炼 qwen3.7-max-preview（主 LLM：财务叙述、CrewAI 等）
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_max_preview_api_key
LLM_MODEL=qwen3.7-max-preview
LLM_BASE_URL=https://llm-4zstl2gr1cq1v43s.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# 财务叙述备用 LLM（OpenAI 兼容，可选；配置后与主 LLM 竞速）
FINANCIAL_NARRATIVE_BACKUP_LLM_API_KEY=
FINANCIAL_NARRATIVE_BACKUP_LLM_BASE_URL=
FINANCIAL_NARRATIVE_BACKUP_LLM_MODEL=

# 分析诊断 LLM 池（深度归因/叙述竞速）
# 复用 LLM_API_KEY / LLM_BASE_URL；逗号分隔多个模型 ID。
# 默认提供 4 个备用模型，由系统按用途分配：
#   qwen3.7-max-2026-06-08      → 年报经营讨论章节深度归因抽取（主）
#   qwen3.7-max-2026-05-17      → 财务/行业叙述竞速选手 A
#   qwen3.7-plus                → 财务/行业叙述竞速选手 B（快、省额度）
#   qwen3.6-plus-2026-04-02     → 最后故障转移兜底
ANALYSIS_LLM_MODELS=qwen3.7-max-2026-06-08,qwen3.7-max-2026-05-17,qwen3.7-plus,qwen3.6-plus-2026-04-02
ANALYSIS_LLM_MAX_TOKENS=8192
ANALYSIS_LLM_TIMEOUT_SECONDS=120

# OpenAI 兼容配置（CrewAI 使用）
OPENAI_API_KEY=your_max_preview_api_key
OPENAI_API_BASE=https://llm-4zstl2gr1cq1v43s.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# LangGraph 配置
LANGGRAPH_RECURSION_LIMIT=25
LANGGRAPH_CHECKPOINT_DIR=./checkpoints

# Rebecca 配置
REBECCA_OUTPUT_DIR=./output

# 任务快照持久化
# 默认使用 backend/db/ddg_tasks.sqlite3 保存 task/report/interrupt JSON 快照。
# PoC 阶段无需额外配置；生产环境建议迁移 PostgreSQL/Redis 并增加租户隔离。

# 缓存配置（减少重复外部 API / LLM 调用）
# 工具结果缓存：按 (tool_name, params) 缓存；LLM 缓存：按 (model, prompt) 缓存。
ENABLE_TOOL_CACHE=true
ENABLE_LLM_CACHE=true
CACHE_DB_PATH=
TOOL_CACHE_TTL_SECONDS=86400
LLM_CACHE_TTL_SECONDS=3600
TOOL_CACHE_TTL_BY_TOOL={"bocha":3600,"searxng":1800,"eastmoney_structured":604800}
CLEAR_CACHE_ON_START=false

# LangSmith 可选配置（用于调试和监控）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=ddg-agent

# 搜索工具配置
TAVILY_API_KEY=
BOCHA_API_KEY=
BOCHA_SEARCH_TIMEOUT_SECONDS=15

# SearXNG 聚合搜索（可选；建议先用 infra/searxng/docker-compose.yml 启动本地服务）
ENABLE_SEARXNG_SEARCH=false
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=15
SEARXNG_MAX_RESULTS=8

# 网页正文读取增强（可选；本地开发可复用系统 Google Chrome）
ENABLE_CRAWL4AI_READER=false
CRAWL4AI_TIMEOUT_SECONDS=20
CRAWL4AI_MAX_PAGES_PER_TASK=3
CRAWL4AI_CHROME_CHANNEL=chrome

# MCP 搜索服务（可选；配置后作为 Tavily 备用通道）
EXA_MCP_URL=
EXA_MCP_COMMAND=
EXA_MCP_ARGS=
EXA_MCP_TOOL=
EXA_API_KEY=
MCP_SEARCH_TIMEOUT_SECONDS=20

# Sequential Thinking MCP（可选；用于 DeepResearch 规划/反思增强）
ENABLE_SEQUENTIAL_THINKING=false
SEQUENTIAL_THINKING_TRANSPORT=stdio
SEQUENTIAL_THINKING_REMOTE_URL=http://127.0.0.1:38001/mcp
SEQUENTIAL_THINKING_MCP_COMMAND=npx
SEQUENTIAL_THINKING_MCP_ARGS="-y @modelcontextprotocol/server-sequential-thinking"
SEQUENTIAL_THINKING_MCP_TIMEOUT_SECONDS=20

# DeepResearch LLM Planner（Plan-Execute 架构中的 plan 节点）- 阿里云百炼 qwen3.7-plus
ENABLE_LLM_RESEARCH_PLANNER=true
RESEARCH_PLANNER_TIMEOUT_SECONDS=90
RESEARCH_PLANNER_MAX_TASKS=6
RESEARCH_PLANNER_LLM_API_KEY=your_plus_api_key
RESEARCH_PLANNER_LLM_BASE_URL=https://llm-4zstl2gr1cq1v43s.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RESEARCH_PLANNER_LLM_MODEL=qwen3.7-plus

# 巨潮资讯 WebAPI（结构化财务/股东/司法数据）
# 申请地址: https://webapi.cninfo.com.cn
CNINFO_ACCESS_TOKEN=your_cninfo_access_token

# 元典法律/企业信息平台（MCP streamable-HTTP）
# 申请地址: https://open.chineselaw.com
YUANDIAN_API_KEY=your_yuandian_api_key
YUANDIAN_LAW_MCP_URL=https://open.chineselaw.com/mcp/law/stream
YUANDIAN_CASE_MCP_URL=https://open.chineselaw.com/mcp/case/stream
YUANDIAN_COMPANY_MCP_URL=https://open.chineselaw.com/mcp/company/stream
YUANDIAN_MCP_TIMEOUT_SECONDS=30

# MinerU 云端 PDF 解析服务
# 申请地址: https://mineru.net/apiManage/docs
MINERU_ENABLED=true
MINERU_API_TOKEN=your_mineru_api_token
MINERU_MODEL_VERSION=vlm
MINERU_ENABLE_OCR=false
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch
MINERU_POLL_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_MAX_FILE_SIZE_MB=200
MINERU_MAX_PAGES_PER_TASK=200
