# backend/.env.example
# 应用配置
APP_NAME=DDG-Agent-Backend
APP_VERSION=2.0.0
DEBUG=true

# 服务配置
HOST=0.0.0.0
PORT=8000

# LLM 配置 - Xiaomi Mimo
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_xiaomi_mimo_api_key
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# 财务叙述备用 LLM（OpenAI 兼容，可选；配置后与主 LLM 竞速）
FINANCIAL_NARRATIVE_BACKUP_LLM_API_KEY=
FINANCIAL_NARRATIVE_BACKUP_LLM_BASE_URL=
FINANCIAL_NARRATIVE_BACKUP_LLM_MODEL=

# OpenAI 兼容配置（CrewAI 使用）
OPENAI_API_KEY=your_xiaomi_mimo_api_key
OPENAI_API_BASE=https://token-plan-cn.xiaomimimo.com/v1

# LangGraph 配置
LANGGRAPH_RECURSION_LIMIT=25
LANGGRAPH_CHECKPOINT_DIR=./checkpoints

# Rebecca 配置
REBECCA_OUTPUT_DIR=./output

# LangSmith 可选配置（用于调试和监控）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=ddg-agent

# 搜索工具配置
TAVILY_API_KEY=
BOCHA_API_KEY=
BOCHA_SEARCH_TIMEOUT_SECONDS=15

# MCP 搜索服务（可选；配置后作为 Tavily 备用通道）
EXA_MCP_URL=
EXA_MCP_COMMAND=
EXA_MCP_ARGS=
EXA_MCP_TOOL=
EXA_API_KEY=
DUCKDUCKGO_MCP_URL=
DUCKDUCKGO_MCP_COMMAND=
DUCKDUCKGO_MCP_ARGS=
DUCKDUCKGO_MCP_TOOL=
MCP_SEARCH_TIMEOUT_SECONDS=20

# Sequential Thinking MCP（可选；用于 DeepResearch 规划/反思增强）
ENABLE_SEQUENTIAL_THINKING=false
SEQUENTIAL_THINKING_MCP_COMMAND=npx
SEQUENTIAL_THINKING_MCP_ARGS="-y @modelcontextprotocol/server-sequential-thinking"
SEQUENTIAL_THINKING_MCP_TIMEOUT_SECONDS=20

# DeepResearch LLM Planner（Plan-Execute 架构中的 plan 节点）
ENABLE_LLM_RESEARCH_PLANNER=true
RESEARCH_PLANNER_TIMEOUT_SECONDS=30
RESEARCH_PLANNER_MAX_TASKS=8
RESEARCH_PLANNER_LLM_API_KEY=
RESEARCH_PLANNER_LLM_BASE_URL=https://api.deepseek.com
RESEARCH_PLANNER_LLM_MODEL=deepseek-v4-flash
